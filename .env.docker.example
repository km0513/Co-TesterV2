# ===== Playwright Configuration =====
# Set to 'true' for headless mode (no browser window), 'false' for headed mode (visible browser)
# For interactive features (Bug Builder, Test Generator), set to 'false' and use VNC
# Headless is recommended for Docker/production, headed for local debugging or with VNC
PLAYWRIGHT_HEADLESS=true

# ===== VNC Configuration (Optional) =====
# Enable VNC server to view and interact with browser inside Docker
# Useful for Bug Builder, Test Generator, and debugging
# Requires exposing port 5900: docker run -p 5900:5900 ...
ENABLE_VNC=false
VNC_PASSWORD=cotester

# ===== X Server Configuration (Optional, Advanced) =====
# For Windows users with VcXsrv or similar X Server installed
# Set to your Windows IP address (get with 'ipconfig')
# Example: DISPLAY=192.168.1.100:0.0
# DISPLAY=:99

# ===== Flask Environment =====
