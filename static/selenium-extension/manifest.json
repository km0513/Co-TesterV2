{
  "manifest_version": 3,
  "name": "Selenium UI Recorder",
  "version": "1.0",
  "description": "Record UI actions and export as Selenium Java code.",
  "permissions": ["scripting", "activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}